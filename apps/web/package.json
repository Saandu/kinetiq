{
  "name": "@kinetiq/web",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Kinetiq - condition monitoring dashboard for industrial machines",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
