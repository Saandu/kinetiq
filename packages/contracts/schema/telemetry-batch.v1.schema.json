{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "machineId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "readings": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          },
          "online": {
            "type": "boolean"
          },
          "state": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "metrics": {
            "type": "object",
            "properties": {
              "temperatureC": {
                "type": "number"
              },
              "vibrationMmS": {
                "type": "number",
                "minimum": 0
              },
              "spindleRpm": {
                "type": "number",
                "minimum": 0
              },
              "powerKw": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "temperatureC",
              "vibrationMmS",
              "spindleRpm",
              "powerKw"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ts",
          "online",
          "state",
          "metrics"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "machineId",
    "seq",
    "readings"
  ],
  "additionalProperties": false
}
