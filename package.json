{
  "name": "kinetiq",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Kinetiq - condition monitoring dashboard for industrial machines",
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kinetiq/web",
    "build": "npm run build --workspace @kinetiq/contracts && npm run build --workspace @kinetiq/runtime && npm run build --workspace @kinetiq/db && npm run build --workspace @kinetiq/simulator && npm run build --workspace @kinetiq/local-bridge && npm run build --workspace @kinetiq/ingest && npm run build --workspace @kinetiq/api && npm run build --workspace @kinetiq/web",
    "build:only": "npm run build:only --workspace @kinetiq/web",
    "preview": "npm run preview --workspace @kinetiq/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @kinetiq/web",
    "verify": "npm run db:image && npm run lint && npm run build && npm run typecheck && npm run test",
    "lint": "eslint apps/web packages services",
    "db:image": "docker build -t kinetiq-postgres:18.6-1 infra/docker/postgres",
    "test:pipeline": "npm run test:pipeline --workspace @kinetiq/pipeline-tests",
    "services:images": "node scripts/build-service-images.mjs",
    "local:up": "docker compose up --build -d --wait --wait-timeout 240",
    "local:down": "docker compose down",
    "local:verify": "node scripts/verify-local.mjs",
    "k8s:tools": "node scripts/setup-k8s-tools.mjs",
    "k8s:up": "node scripts/k8s-cluster.mjs up",
    "k8s:stop": "node scripts/k8s-cluster.mjs stop",
    "k8s:status": "node scripts/k8s-cluster.mjs status",
    "k8s:verify": "node scripts/k8s-cluster.mjs verify",
    "k8s:images": "node scripts/k8s-cluster.mjs images",
    "k8s:images:verify": "node scripts/k8s-cluster.mjs images-verify",
    "k8s:kubectl": "node scripts/k8s-cluster.mjs kubectl",
    "helm:verify": "node scripts/verify-helm.mjs",
    "helm:smoke": "npm run helm:verify && node scripts/smoke-helm-web.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
