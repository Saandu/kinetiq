{
  "name": "kinetiq",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Kinetiq - condition monitoring dashboard for industrial machines",
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kinetiq/web",
    "build": "npm run build --workspace @kinetiq/contracts && npm run build --workspace @kinetiq/web",
    "build:only": "npm run build:only --workspace @kinetiq/web",
    "preview": "npm run preview --workspace @kinetiq/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @kinetiq/web",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint apps/web packages/contracts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
